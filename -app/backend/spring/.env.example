# Isolated Spring development only. Set values privately in the Java process environment.
BIZFLOW_FOUNDATION_DATABASE=bizflow_foundation_dev
BIZFLOW_FOUNDATION_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/bizflow_foundation_dev
BIZFLOW_FOUNDATION_DB_USER=bizflow_foundation
BIZFLOW_FOUNDATION_DB_PASSWORD=
# Generate at least 32 random bytes and encode them in base64.
BIZFLOW_AUTH_SIGNING_KEY=
BIZFLOW_AUTH_ISSUER=https://bizflow-spring.example.invalid
BIZFLOW_AUTH_AUDIENCE=bizflow-owner
BIZFLOW_AUTH_APP_URL=http://localhost:8081
# SMTP requires an HTTPS application URL and either starttls or implicit TLS.
BIZFLOW_AUTH_SMTP_ENABLED=false
BIZFLOW_AUTH_SMTP_HOST=
BIZFLOW_AUTH_SMTP_PORT=587
BIZFLOW_AUTH_SMTP_TLS=starttls
BIZFLOW_AUTH_SMTP_USER=
BIZFLOW_AUTH_SMTP_PASSWORD=
BIZFLOW_AUTH_SMTP_FROM=
