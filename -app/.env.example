# Local development. Generate the secret and replace the owner placeholders before starting.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
BIZFLOW_OWNER_NAME=Owner
BIZFLOW_OWNER_EMAIL=owner@example.invalid
BIZFLOW_OWNER_PASSWORD=
BIZFLOW_DATABASE=sqlite
BIZFLOW_DB_PATH=data/bizflow.sqlite
# For PostgreSQL, set BIZFLOW_DATABASE=postgres and point to an imported schema.
DATABASE_URL=
BIZFLOW_POSTGRES_SCHEMA=bizflow
# Optional for disposable development databases only.
BIZFLOW_ALLOW_SCHEMA_UPGRADE=0

# Optional email recovery. An operator must verify control of the registered owner's email.
BIZFLOW_VERIFIED_RECOVERY_EMAIL=
# smtp for delivery, file for disposable local testing, blank to disable
BIZFLOW_RECOVERY_TRANSPORT=
BIZFLOW_RECOVERY_OUTBOX=
BIZFLOW_SMTP_HOST=
BIZFLOW_SMTP_PORT=587
BIZFLOW_SMTP_USER=
BIZFLOW_SMTP_PASSWORD=
BIZFLOW_SMTP_FROM=
